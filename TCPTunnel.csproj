<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>TCPTunnel</RootNamespace>
    <AssemblyName>TCPTunnel</AssemblyName>
    <AssemblyTitle>TCPTunnel</AssemblyTitle>
    <Description></Description>
    <Company></Company>
    <Product>TCPTunnel</Product>
    <Copyright>Copyright © 2022</Copyright>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Deterministic>true</Deterministic>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
    <Compile Remove="CryptoPrototype/**/*.cs" />
    <None Include="obj/NativeCrypto/x86_64-pc-windows-msvc/release/tcptunnel_crypto.dll" Link="tcptunnel_crypto.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <PackageReference Include="SharpOpenNat" Version="4.0.19" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="default.cfg"
                      LogicalName="TCPTunnel.default.cfg" />
    <EmbeddedResource Include="DuelSetup.ps1" LogicalName="TCPTunnel.DuelSetup.ps1" />
    <EmbeddedResource Include="SecurityData/confusables.txt" LogicalName="TCPTunnel.Security.Confusables" />
    <EmbeddedResource Include="SecurityData/LICENSE.txt" LogicalName="TCPTunnel.NativeCrypto.Licenses.Unicode.txt" />
    <EmbeddedResource Include="NativeCrypto/THIRD_PARTY_NOTICES.md" LogicalName="TCPTunnel.NativeCrypto.Notices" />
    <EmbeddedResource Include="NativeCrypto/third-party-licenses/*" LogicalName="TCPTunnel.NativeCrypto.Licenses.%(Filename)%(Extension)" />
  </ItemGroup>

  <Target Name="PublishLite">
    <Exec Command="pwsh -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\build-lite.ps1&quot; -Configuration $(Configuration)" />
  </Target>

  <Target Name="PublishSelfContained">
    <Exec Command="pwsh -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\build-selfcontained.ps1&quot; -Configuration $(Configuration)" />
  </Target>

</Project>
