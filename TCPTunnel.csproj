<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>TCPTunnel</RootNamespace>
    <AssemblyName>TCPTunnel</AssemblyName>
    <AssemblyTitle>TCPTunnel</AssemblyTitle>
    <Description></Description>
    <Company></Company>
    <Product>TCPTunnel</Product>
    <Copyright>Copyright © 2022</Copyright>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Deterministic>true</Deterministic>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
    <PackageReference Include="SharpOpenNat" Version="4.0.19" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="default.cfg"
                      LogicalName="TCPTunnel.default.cfg" />
  </ItemGroup>

  <Target Name="PublishLite">
    <Exec Command="pwsh -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\build-lite.ps1&quot; -Configuration $(Configuration)" />
  </Target>

</Project>
